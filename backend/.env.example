# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://autoscribe:autoscribe@localhost:5433/autoscribe

# ── CORS / App URLs ────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── GitHub OAuth App ───────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Set Authorization callback URL to: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ── GitHub Webhook ─────────────────────────────────────────────────────────────
# Secret used to verify incoming webhook payloads from GitHub
GITHUB_WEBHOOK_SECRET=dev-webhook-secret

# ── Token Encryption ───────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# ── LLM API ────────────────────────────────────────────────────────────────────
# OpenAI-compatible endpoint. Defaults to OpenAI; change BASE_URL for Azure / Ollama / etc.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small